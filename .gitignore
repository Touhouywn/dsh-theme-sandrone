.env
.env.*
!.env.example
*.pem
*.key
*.p12
*.pfx
*.jks
id_rsa*
id_ed25519*
.npmrc
.pypirc
.netrc
secrets.*
credentials.*
*.log

# Research material and screenshot output
.research/

# DSH ops lock files that appear when file tools touch a directory
.dsh-ops-update-*.lock

# Editors
.vscode/
.idea/
*.swp
